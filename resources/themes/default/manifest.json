{
  "id": "default",
  "type": "theme",
  "version": "1.0.0",
  "name": "PLAIK Default",
  "core": ">=0.1.0",
  "parent": null,
  "theme_api": 1,
  "layouts": [
    "full-width"
  ],
  "assets": {
    "css": [
      "assets/css/theme.css"
    ],
    "js": []
  },
  "hooks": [
    "displayHeader",
    "displayContent",
    "displayFooter"
  ],
  "slots": [
    "control.order.sidebar",
    "storefront.cart.summary",
    "storefront.checkout.shipping",
    "storefront.footer.columns",
    "storefront.footer.newsletter",
    "storefront.header.account",
    "storefront.header.cart",
    "storefront.header.compare",
    "storefront.header.search",
    "storefront.header.wishlist",
    "storefront.home.featured",
    "storefront.product.add-to-cart",
    "storefront.product.after-price",
    "storefront.product.compare",
    "storefront.product.purchase",
    "storefront.product.quick-view",
    "storefront.product.rating",
    "storefront.product.reviews",
    "storefront.product.wishlist"
  ],
  "page_templates": [
    "home",
    "error",
    "maintenance"
  ],
  "sections": [
    "announcement",
    "breadcrumbs",
    "footer",
    "header",
    "navigation",
    "product-card",
    "product-grid",
    "text",
    "hero",
    "status"
  ],
  "blocks": [
    "badge",
    "button",
    "divider",
    "heading",
    "icon",
    "image",
    "link",
    "module-slot",
    "nav-item",
    "price",
    "product-image",
    "product-metadata",
    "product-title",
    "rich-text",
    "spacer",
    "text"
  ],
  "settings_schema": true,
  "presets": [
    "default"
  ]
}
