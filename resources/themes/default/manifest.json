{
  "id": "default",
  "type": "theme",
  "version": "1.0.0",
  "name": "PLAIK Default",
  "core": ">=0.1.0",
  "parent": null,
  "theme_api": 1,
  "layouts": ["full-width"],
  "assets": {
    "css": ["assets/css/theme.css"],
    "js": []
  },
  "hooks": [
    "displayHeader",
    "displayContent",
    "displayFooter"
  ],
  "slots": [
    "storefront.header.search",
    "storefront.header.cart",
    "storefront.product.after-price",
    "storefront.product.purchase",
    "storefront.product.reviews",
    "storefront.cart.summary",
    "storefront.checkout.shipping",
    "control.order.sidebar"
  ],
  "page_templates": ["home", "error", "maintenance"],
  "sections": ["hero", "status"],
  "blocks": ["heading"],
  "settings_schema": true,
  "presets": ["default"]
}
