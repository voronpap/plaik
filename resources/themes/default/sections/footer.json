{
  "type": "footer",
  "template": "sections/footer.html",
  "settings": [
    {
      "id": "columns",
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "default": 3
    },
    {
      "id": "show_copyright",
      "type": "boolean",
      "default": true
    }
  ],
  "slots": [
    "storefront.footer.columns",
    "storefront.footer.newsletter"
  ],
  "allowed_blocks": [
    "text",
    "link",
    "nav-item"
  ],
  "max_blocks": 12,
  "max_block_nesting_depth": 1
}
