{
  "type": "hero",
  "template": "sections/hero.html",
  "settings": [
    {
      "id": "heading",
      "type": "string",
      "max_length": 120,
      "default": ""
    },
    {
      "id": "alignment",
      "type": "enum",
      "choices": [
        "left",
        "center",
        "right"
      ],
      "default": "left"
    }
  ],
  "allowed_blocks": [
    "heading",
    "product-card",
    "ui-state"
  ],
  "max_blocks": 24,
  "max_block_nesting_depth": 1,
  "slots": [
    "storefront.home.featured"
  ]
}
