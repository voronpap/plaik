{
  "type": "product",
  "template": "sections/product.html",
  "settings": [
    {
      "id": "layout",
      "type": "enum",
      "choices": [
        "classic",
        "wide-gallery",
        "sticky"
      ],
      "default": "classic"
    }
  ],
  "slots": [
    "storefront.product.gallery",
    "storefront.product.after-price",
    "storefront.product.availability",
    "storefront.product.variants",
    "storefront.product.add-to-cart",
    "storefront.product.rating",
    "storefront.product.reviews",
    "storefront.product.purchase",
    "storefront.seo.structured-data"
  ],
  "allowed_blocks": [
    "ui-state"
  ],
  "max_blocks": 24,
  "max_block_nesting_depth": 1
}
